# ============================================================================
# CoinTracer — Environment Variables Template
# ============================================================================
# Copy this file to .env (local dev) or .env.production (deployment)
#   cp .env.example .env
#
# NEVER commit real secrets to version control!
# ============================================================================

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# Option 1: Connection string (for cloud Postgres: Neon, Supabase, Railway)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option 2: Individual credentials (for local development)
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=postgres

# Also expose DB_* for services that read these keys
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# Per-service schema isolation (set by Docker Compose per container)
# DB_SCHEMA=users_svc           # user-service
# DB_SCHEMA=portfolios_svc      # exchange-connections-service
# DB_SCHEMA=personalization_svc  # personalization-service
# DB_SCHEMA=alerts_svc           # alerts-service

# --------------------------------------------------------------------------
# Service Ports (local development only — production uses Docker Compose)
# --------------------------------------------------------------------------
USER_SERVICE_PORT=3001
EXCHANGE_CONNECTIONS_PORT=5000
MARKET_DATA_SERVICE_PORT=5001
PERSONALIZATION_SERVICE_PORT=3004
FRONTEND_PORT=5173

# --------------------------------------------------------------------------
# Secrets (CHANGE THESE for production!)
# --------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=dev-jwt-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
API_KEY_HASH_SECRET=dev-hmac-secret

# --------------------------------------------------------------------------
# Service URLs (inter-service communication)
# --------------------------------------------------------------------------
MARKET_DATA_SERVICE_URL=http://localhost:5001/api/v1

# Gateway → Service URLs (used by API Gateway reverse proxy)
USER_SERVICE_URL=http://localhost:3001
PORTFOLIO_SERVICE_URL=http://localhost:5000
MARKET_SERVICE_URL=http://localhost:5001
PERSONALIZATION_SERVICE_URL=http://localhost:3004
ALERTS_SERVICE_URL=http://localhost:5002

# --------------------------------------------------------------------------
# Redis (event bus + cache)
# --------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --------------------------------------------------------------------------
# External APIs
# --------------------------------------------------------------------------
# CoinMarketCap (get yours at https://coinmarketcap.com/api/)
CMC_API_KEY=your-coinmarketcap-api-key-here
CMC_BASE_URL=https://pro-api.coinmarketcap.com

# --------------------------------------------------------------------------
# Production-Only Settings
# --------------------------------------------------------------------------
# NODE_ENV=production
# PORT=3000
# FRONTEND_URL=https://your-app.vercel.app
